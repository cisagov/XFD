<mxfile host="app.diagrams.net" modified="2026-09-11T22:00:00.000Z" agent="Codex" version="24.7.17" compressed="false">
  <diagram id="menu-overview" name="1 Menu Overview">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="o0"/><mxCell id="o1" parent="o0"/>
        <mxCell id="o-title" value="WAS Operator Menu Flow" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="o1"><mxGeometry x="500" y="20" width="600" height="45" as="geometry"/></mxCell>
        <mxCell id="o-subtitle" value="Menu choices, operator prompts, visible feedback, and retained evidence" style="text;html=1;align=center;fontSize=14;fontColor=#4B5563;" vertex="1" parent="o1"><mxGeometry x="450" y="68" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="o-launch" value="Operator runs make menu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="o1"><mxGeometry x="650" y="120" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="o-container" value="Docker starts was-reporting was-menu&#xa;Terminal is cleared and WAS banner is displayed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="o1"><mxGeometry x="625" y="220" width="350" height="80" as="geometry"/></mxCell>
        <mxCell id="o-main" value="WAS Reporting Operations&#xa;1 Report generation&#xa;2 Daily tracker&#xa;3 Stakeholder management&#xa;4 Qualys operations&#xa;5 Quit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=15;" vertex="1" parent="o1"><mxGeometry x="625" y="345" width="350" height="155" as="geometry"/></mxCell>
        <mxCell id="o-report" value="1. Report Generation&#xa;Batch, automatic, manual, and on-demand reports&#xa;See page 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="o1"><mxGeometry x="60" y="610" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="o-tracker" value="2. Daily Tracker&#xa;View, troubleshoot, mark sent, and export&#xa;See page 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="o1"><mxGeometry x="440" y="610" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="o-stake" value="3. Stakeholder Management&#xa;View, update, import, export, add, rotate, and retrieve password&#xa;See page 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="o1"><mxGeometry x="820" y="610" width="350" height="110" as="geometry"/></mxCell>
        <mxCell id="o-qualys" value="4. Qualys Operations&#xa;Inventory and tracker refresh&#xa;See page 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="o1"><mxGeometry x="1220" y="610" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="o-feedback" value="Every operation returns visible terminal feedback&#xa;Success: Operation completed successfully&#xa;Failure: status code or Review the WAS logs for details&#xa;Press Enter returns to the current menu; b returns to main menu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="o1"><mxGeometry x="475" y="805" width="650" height="120" as="geometry"/></mxCell>
        <mxCell id="oe1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="o1" source="o-launch" target="o-container"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="o1" source="o-container" target="o-main"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe3" value="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="o1" source="o-main" target="o-report"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe4" value="2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="o1" source="o-main" target="o-tracker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe5" value="3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="o1" source="o-main" target="o-stake"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe6" value="4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="o1" source="o-main" target="o-qualys"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="o1" source="o-main" target="o-feedback"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="report-menu" name="2 Report Generation">
    <mxGraphModel dx="1800" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="r0"/><mxCell id="r1" parent="r0"/>
        <mxCell id="r-title" value="Report Generation Menu: User Interaction and Feedback" style="text;html=1;align=center;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="r1"><mxGeometry x="400" y="20" width="1000" height="45" as="geometry"/></mxCell>
        <mxCell id="r-menu" value="Report Generation&#xa;1 Complete recent-scan batch&#xa;2 Eligible automatic tracker reports&#xa;3 Eligible manual tracker report&#xa;4 New on-demand report&#xa;5 or b Back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="600" y="85" width="600" height="145" as="geometry"/></mxCell>
        <mxCell id="r-h1" value="Menu choice" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="30" y="280" width="300" height="45" as="geometry"/></mxCell>
        <mxCell id="r-h2" value="Operator interaction" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="330" y="280" width="460" height="45" as="geometry"/></mxCell>
        <mxCell id="r-h3" value="Live terminal feedback" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="790" y="280" width="500" height="45" as="geometry"/></mxCell>
        <mxCell id="r-h4" value="Stored result and error evidence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="1290" y="280" width="480" height="45" as="geometry"/></mxCell>

        <mxCell id="r-a1" value="1. Complete recent-scan batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="30" y="345" width="300" height="180" as="geometry"/></mxCell>
        <mxCell id="r-a2" value="Choose delivery mode:&#xa;1 active analyst override&#xa;2 customer delivery&#xa;3 cancel&#xa;&#xa;Analyst mode asks for approved assignee email and confirmation. Customer mode requires typing SEND CUSTOMER REPORTS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="r1"><mxGeometry x="330" y="345" width="460" height="180" as="geometry"/></mxCell>
        <mxCell id="r-a3" value="Refreshes Qualys tracker data, identifies candidates, claims each run, displays Qualys request and polling progress, generation and S3 archive messages, SES acceptance, and final candidates/generated/sent/failed summary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="r1"><mxGeometry x="790" y="345" width="500" height="180" as="geometry"/></mxCell>
        <mxCell id="r-a4" value="Postgres: tracker rows, report runs, run status, S3 URI, email status, SES message ID.&#xa;S3: encrypted PDF by date/tag/run.&#xa;Errors: run stage and summary in database, full context in retained log, included in assignee digest." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="r1"><mxGeometry x="1290" y="345" width="480" height="180" as="geometry"/></mxCell>

        <mxCell id="r-b1" value="2. Eligible automatic tracker report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="30" y="545" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="r-b2" value="Enter stakeholder tag. Confirm generation and customer email delivery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="r1"><mxGeometry x="330" y="545" width="460" height="150" as="geometry"/></mxCell>
        <mxCell id="r-b3" value="Shows tracker refresh and eligibility progress. If no eligible scan gap exists, reports zero candidates. Otherwise shows generation, S3, SES, and completion status." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="r1"><mxGeometry x="790" y="545" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="r-b4" value="Uses existing tracker row. Successful delivery updates report run and tracker sent state. Duplicate claims are skipped. Failure is persisted and logged." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="r1"><mxGeometry x="1290" y="545" width="480" height="150" as="geometry"/></mxCell>

        <mxCell id="r-c1" value="3. Eligible manual tracker report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="30" y="715" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="r-c2" value="Enter stakeholder tag. Confirm manual report generation and customer email delivery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="r1"><mxGeometry x="330" y="715" width="460" height="145" as="geometry"/></mxCell>
        <mxCell id="r-c3" value="Uses existing tracker data without refreshing Qualys schedules. Displays generation, archive, email retry, or no-candidate feedback." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="r1"><mxGeometry x="790" y="715" width="500" height="145" as="geometry"/></mxCell>
        <mxCell id="r-c4" value="Links run to manual tracker row. A completed unsent report may retry email without regenerating the PDF. Run and email failures remain queryable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="r1"><mxGeometry x="1290" y="715" width="480" height="145" as="geometry"/></mxCell>

        <mxCell id="r-d1" value="4. New on-demand report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="30" y="880" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="r-d2" value="Enter tag. Choose whether to email. If yes, enter active WAS assignee recipient. Optionally enter existing tracker ID. Confirm a NEW report will be generated and archived." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="r1"><mxGeometry x="330" y="880" width="460" height="190" as="geometry"/></mxCell>
        <mxCell id="r-d3" value="Displays created run ID, long-running Qualys activity and polling, report completion, S3 URI, and optional SES message ID. Without tracker ID, explicitly states no scan tracker row was created or changed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="r1"><mxGeometry x="790" y="880" width="500" height="190" as="geometry"/></mxCell>
        <mxCell id="r-d4" value="Always creates was_report_runs row. Archives PDF to S3. Optional analyst-only email is recorded. With tracker ID, links to that row. Failure records stage and safe exception summary; full details remain in the application log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="r1"><mxGeometry x="1290" y="880" width="480" height="190" as="geometry"/></mxCell>

        <mxCell id="r-note" value="Special path: All NWS and FCEB All NWS tracker templates send the approved notification without generating or attaching a PDF." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="330" y="1110" width="960" height="70" as="geometry"/></mxCell>
        <mxCell id="r-back" value="5 or b returns to the main menu. Press Enter after an operation returns to Report Generation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="r1"><mxGeometry x="500" y="1210" width="800" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="tracker-menu" name="3 Daily Tracker">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="t0"/><mxCell id="t1" parent="t0"/>
        <mxCell id="t-title" value="Daily Tracker Menu: User Interaction and Feedback" style="text;html=1;align=center;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="t1"><mxGeometry x="430" y="20" width="940" height="45" as="geometry"/></mxCell>
        <mxCell id="t-menu" value="Daily Tracker&#xa;1 View tracker table&#xa;2 View persisted report errors&#xa;3 Record manual report sent date&#xa;4 Export tracker CSV&#xa;5 or b Back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="600" y="85" width="600" height="140" as="geometry"/></mxCell>
        <mxCell id="t-h1" value="Menu choice" style="fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="t1"><mxGeometry x="30" y="275" width="300" height="45" as="geometry"/></mxCell>
        <mxCell id="t-h2" value="Operator interaction" style="fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="t1"><mxGeometry x="330" y="275" width="460" height="45" as="geometry"/></mxCell>
        <mxCell id="t-h3" value="Visible feedback" style="fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="t1"><mxGeometry x="790" y="275" width="500" height="45" as="geometry"/></mxCell>
        <mxCell id="t-h4" value="Data and troubleshooting" style="fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="t1"><mxGeometry x="1290" y="275" width="480" height="45" as="geometry"/></mxCell>
        <mxCell id="t-a1" value="1. View tracker table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="30" y="340" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="t-a2" value="Enter days back, exact assignee name or all, report status, and row count. Default is 200 rows; all is accepted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="t1"><mxGeometry x="330" y="340" width="460" height="150" as="geometry"/></mxCell>
        <mxCell id="t-a3" value="Displays terminal table and Displayed N tracker rows. Invalid, inactive, or misspelled assignee names return a direct explanation instead of an empty misleading result." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="t1"><mxGeometry x="790" y="340" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="t-a4" value="Read-only query against was_daily_report_tracker and was_assignees. Database or query errors are displayed and retained in the application log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="t1"><mxGeometry x="1290" y="340" width="480" height="150" as="geometry"/></mxCell>
        <mxCell id="t-b1" value="2. View persisted report errors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="30" y="510" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="t-b2" value="Enter days back and optional stakeholder tag." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="t1"><mxGeometry x="330" y="510" width="460" height="140" as="geometry"/></mxCell>
        <mxCell id="t-b3" value="Displays run ID, tag, stage, status, start time, and safe error summary, followed by Displayed N report errors." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="t1"><mxGeometry x="790" y="510" width="500" height="140" as="geometry"/></mxCell>
        <mxCell id="t-b4" value="Reads failed generation and delivery records from was_report_runs. Use the run ID and timestamp to correlate with /output/logs/was-reporting-*.log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="t1"><mxGeometry x="1290" y="510" width="480" height="140" as="geometry"/></mxCell>
        <mxCell id="t-c1" value="3. Record manual sent date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="30" y="670" width="300" height="165" as="geometry"/></mxCell>
        <mxCell id="t-c2" value="First choose days back, optional assignee, and row count. Review displayed manual rows. Then enter tracker row ID, sent date, and confirm." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="t1"><mxGeometry x="330" y="670" width="460" height="165" as="geometry"/></mxCell>
        <mxCell id="t-c3" value="Shows manual tracker table before asking for the ID. Confirms success or reports validation/database failure. Cancellation makes no update." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="t1"><mxGeometry x="790" y="670" width="500" height="165" as="geometry"/></mxCell>
        <mxCell id="t-c4" value="Updates only the selected daily tracker row after explicit confirmation. The change remains auditable in PostgreSQL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="t1"><mxGeometry x="1290" y="670" width="480" height="165" as="geometry"/></mxCell>
        <mxCell id="t-d1" value="4. Export tracker CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="30" y="855" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="t-d2" value="Accept or change output path, days back, and optional assignee." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="t1"><mxGeometry x="330" y="855" width="460" height="145" as="geometry"/></mxCell>
        <mxCell id="t-d3" value="Reports Exported N tracker rows to PATH, then operation success. The host receives the file through the /output volume." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="t1"><mxGeometry x="790" y="855" width="500" height="145" as="geometry"/></mxCell>
        <mxCell id="t-d4" value="Default container path: /output/was-daily-tracker.csv. Host path: backend/was/local-output/was-daily-tracker.csv." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="t1"><mxGeometry x="1290" y="855" width="480" height="145" as="geometry"/></mxCell>
        <mxCell id="t-back" value="5 or b returns to the main menu. Press Enter after an operation returns to Daily Tracker." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="t1"><mxGeometry x="500" y="1050" width="800" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="stakeholder-menu" name="4 Stakeholder Management">
    <mxGraphModel dx="1800" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="s0"/><mxCell id="s1" parent="s0"/>
        <mxCell id="s-title" value="Stakeholder Management Menu: User Interaction and Feedback" style="text;html=1;align=center;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="s1"><mxGeometry x="350" y="20" width="1100" height="45" as="geometry"/></mxCell>
        <mxCell id="s-menu" value="Stakeholder Management&#xa;1 Update contacts | 2 View/update row | 3 Export | 4 Import CSV&#xa;5 Add stakeholder | 6 Rotate password | 7 Retrieve password | 8 or b Back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="520" y="85" width="760" height="105" as="geometry"/></mxCell>
        <mxCell id="s-h1" value="Menu choice" style="fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="s1"><mxGeometry x="30" y="235" width="300" height="45" as="geometry"/></mxCell>
        <mxCell id="s-h2" value="Operator interaction" style="fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="s1"><mxGeometry x="330" y="235" width="500" height="45" as="geometry"/></mxCell>
        <mxCell id="s-h3" value="Visible feedback" style="fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="s1"><mxGeometry x="830" y="235" width="470" height="45" as="geometry"/></mxCell>
        <mxCell id="s-h4" value="Data and safeguards" style="fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="s1"><mxGeometry x="1300" y="235" width="470" height="45" as="geometry"/></mxCell>
        <mxCell id="s-a1" value="1. Update POC names and emails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="30" y="300" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="s-a2" value="Enter tag. For report POC, technical POC email, and distro email: Enter keeps current, CLEAR removes, or type replacement. Confirm updates." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="s1"><mxGeometry x="330" y="300" width="500" height="145" as="geometry"/></mxCell>
        <mxCell id="s-a3" value="Reports no changes, cancellation, updated contact fields, or a validation/database error." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="s1"><mxGeometry x="830" y="300" width="470" height="145" as="geometry"/></mxCell>
        <mxCell id="s-a4" value="Updates only selected was_stakeholders contact fields. Empty input does not erase data." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="s1"><mxGeometry x="1300" y="300" width="470" height="145" as="geometry"/></mxCell>
        <mxCell id="s-b1" value="2. View or update a row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="30" y="465" width="300" height="180" as="geometry"/></mxCell>
        <mxCell id="s-b2" value="Enter tag. Review current table. Optionally enter field names to print complete untruncated values. Then cycle every editable field with current value prefilled. Enter keeps; edit changes; CLEAR sets NULL; CANCEL stops." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="s1"><mxGeometry x="330" y="465" width="500" height="180" as="geometry"/></mxCell>
        <mxCell id="s-b3" value="Displays all current values while masking report password. Epoch fields display readable UTC plus the raw epoch. Invalid field values are explained and reprompted. Reports update count or no changes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="s1"><mxGeometry x="830" y="465" width="470" height="180" as="geometry"/></mxCell>
        <mxCell id="s-b4" value="Validated, confirmed update to was_stakeholders. Password is not editable through this path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="s1"><mxGeometry x="1300" y="465" width="470" height="180" as="geometry"/></mxCell>
        <mxCell id="s-c1" value="3. Export stakeholders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="30" y="665" width="300" height="170" as="geometry"/></mxCell>
        <mxCell id="s-c2" value="Choose local output, S3, active assignee email, or cancel. Optionally include passwords only after typing EXPORT PASSWORDS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="s1"><mxGeometry x="330" y="665" width="500" height="170" as="geometry"/></mxCell>
        <mxCell id="s-c3" value="Reports row count and output path, S3 URI, or delivery result. Sensitive export cancellation is explicit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="s1"><mxGeometry x="830" y="665" width="470" height="170" as="geometry"/></mxCell>
        <mxCell id="s-c4" value="Epoch dates are rendered for human review. Password-containing exports require explicit confirmation and cannot be silently exposed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="s1"><mxGeometry x="1300" y="665" width="470" height="170" as="geometry"/></mxCell>
        <mxCell id="s-d1" value="4. Import new stakeholders from CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="30" y="855" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="s-d2" value="Accept or enter input CSV and prepared output paths. Confirm prepare and import." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="s1"><mxGeometry x="330" y="855" width="500" height="160" as="geometry"/></mxCell>
        <mxCell id="s-d3" value="States existing tags will be skipped. Reports prepared file path and inserted/skipped counts, or row-specific validation/database failure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="s1"><mxGeometry x="830" y="855" width="470" height="160" as="geometry"/></mxCell>
        <mxCell id="s-d4" value="Insert-only workflow. Existing stakeholder rows are not overwritten. Prepared CSV remains available in /output." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="s1"><mxGeometry x="1300" y="855" width="470" height="160" as="geometry"/></mxCell>
        <mxCell id="s-e1" value="5. Add one stakeholder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="30" y="1035" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="s-e2" value="Answer prompts for tag, customer, optional text, epoch dates/counts, and booleans. Confirm creation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="s1"><mxGeometry x="330" y="1035" width="500" height="160" as="geometry"/></mxCell>
        <mxCell id="s-e3" value="Explains invalid integers or required values immediately. States that a report password will be generated automatically. Reports creation or conflict." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="s1"><mxGeometry x="830" y="1035" width="470" height="160" as="geometry"/></mxCell>
        <mxCell id="s-e4" value="Creates one validated was_stakeholders row with generated password and database-managed timestamps." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="s1"><mxGeometry x="1300" y="1035" width="470" height="160" as="geometry"/></mxCell>
        <mxCell id="s-f1" value="6. Rotate report password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="30" y="1215" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="s-f2" value="Enter tag and confirm password rotation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="s1"><mxGeometry x="330" y="1215" width="500" height="140" as="geometry"/></mxCell>
        <mxCell id="s-f3" value="On success displays: Operation completed successfully. The new password is &amp;lt;new_password&amp;gt;. Failure points the operator to the application log without logging the password." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="s1"><mxGeometry x="830" y="1215" width="470" height="140" as="geometry"/></mxCell>
        <mxCell id="s-f4" value="Generates and stores a new validated password. Existing reports retain their original encryption password." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="s1"><mxGeometry x="1300" y="1215" width="470" height="140" as="geometry"/></mxCell>
        <mxCell id="s-g1" value="7. Retrieve report password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="30" y="1375" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="s-g2" value="Enter exact stakeholder tag and confirm that the password should be displayed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="s1"><mxGeometry x="330" y="1375" width="500" height="100" as="geometry"/></mxCell>
        <mxCell id="s-g3" value="Displays the stored password or explains that no password is configured. The password is not written to the application log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="s1"><mxGeometry x="830" y="1375" width="470" height="100" as="geometry"/></mxCell>
        <mxCell id="s-g4" value="Read-only lookup against was_stakeholders. Terminal output is sensitive and should be cleared after use." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="s1"><mxGeometry x="1300" y="1375" width="470" height="100" as="geometry"/></mxCell>
        <mxCell id="s-back" value="8 or b returns to the main menu. Press Enter after an operation returns to Stakeholder Management." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="s1"><mxGeometry x="500" y="1495" width="800" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="qualys-feedback" name="5 Qualys and Error Feedback">
    <mxGraphModel dx="1700" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="q0"/><mxCell id="q1" parent="q0"/>
        <mxCell id="q-title" value="Qualys Operations, User Feedback, and Error Logs" style="text;html=1;align=center;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="q1"><mxGeometry x="350" y="20" width="1000" height="45" as="geometry"/></mxCell>
        <mxCell id="q-menu" value="Qualys Operations&#xa;1 View stakeholder inventory&#xa;2 Refresh the daily tracker&#xa;3 or b Back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="550" y="90" width="600" height="115" as="geometry"/></mxCell>
        <mxCell id="q-inv-user" value="1. Operator selects inventory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="70" y="275" width="300" height="75" as="geometry"/></mxCell>
        <mxCell id="q-inv-warn" value="Menu warns: full inventory can take a long time. Leave it running until inventory or an error is displayed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="q1"><mxGeometry x="425" y="260" width="390" height="105" as="geometry"/></mxCell>
        <mxCell id="q-inv-api" value="Qualys tag and application inventory requests execute. Request start, duration, retries, and safe failure context stream to terminal and log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="q1"><mxGeometry x="870" y="260" width="390" height="105" as="geometry"/></mxCell>
        <mxCell id="q-inv-result" value="Success displays inventory and operation completion. Failure displays a concise message and points the operator to WAS logs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="q1"><mxGeometry x="1315" y="260" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="q-ref-user" value="2. Operator selects tracker refresh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="70" y="410" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="q-ref-prompt" value="Enter exact stakeholder tag or leave blank for all. Confirm refresh. Default path is non-destructive and does not delete Qualys webapps." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="q1"><mxGeometry x="425" y="400" width="390" height="110" as="geometry"/></mxCell>
        <mxCell id="q-ref-api" value="Retrieve schedules and scans, match stakeholder tags/names/cadence, consolidate scan slices, apply manual and special-case rules, assign analysts, and write tracker rows." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="q1"><mxGeometry x="870" y="400" width="390" height="110" as="geometry"/></mxCell>
        <mxCell id="q-ref-result" value="Terminal shows progress and operation completion. PostgreSQL contains the refreshed tracker state. Failures identify the processing area and are retained in logs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="q1"><mxGeometry x="1315" y="400" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="q-divider" value="Shared feedback and error path for every menu operation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=16;" vertex="1" parent="q1"><mxGeometry x="450" y="580" width="800" height="55" as="geometry"/></mxCell>
        <mxCell id="q-exec" value="Menu execute wrapper runs selected command" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="75" y="700" width="285" height="80" as="geometry"/></mxCell>
        <mxCell id="q-decision" value="Exit code 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="430" y="690" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="q-success" value="User sees operation-specific output plus:&#xa;Operation completed successfully.&#xa;Press Enter to continue..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="655" y="660" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="q-fail" value="User sees either:&#xa;Operation exited with status N&#xa;or&#xa;Operation failed. Review the WAS logs for details." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="q1"><mxGeometry x="655" y="825" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="q-console" value="Console log&#xa;UTC timestamp, level, logger, filename:line, and safe message are written immediately to stderr." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="q1"><mxGeometry x="1090" y="650" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="q-file" value="Retained application log&#xa;/output/logs/was-reporting-TIMESTAMP-PID-ID.log&#xa;Host: backend/was/local-output/logs/&#xa;Private permissions, 10 MB rotation, 5 backups, 14-day retention" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="q1"><mxGeometry x="1090" y="810" width="420" height="155" as="geometry"/></mxCell>
        <mxCell id="q-db" value="Persisted operational evidence&#xa;was_report_runs stores generation/email status, stage, safe error summary, S3 URI, and SES message ID.&#xa;Daily Tracker option 2 displays these failures." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="q1"><mxGeometry x="560" y="1010" width="580" height="145" as="geometry"/></mxCell>
        <mxCell id="qe1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="q1" source="q-inv-user" target="q-inv-warn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="q1" source="q-inv-warn" target="q-inv-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="q1" source="q-inv-api" target="q-inv-result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="q1" source="q-ref-user" target="q-ref-prompt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="q1" source="q-ref-prompt" target="q-ref-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="q1" source="q-ref-api" target="q-ref-result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="q1" source="q-exec" target="q-decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe8" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="q1" source="q-decision" target="q-success"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe9" value="no or exception" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#B85450;" edge="1" parent="q1" source="q-decision" target="q-fail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="q1" source="q-exec" target="q-console"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="q1" source="q-console" target="q-file"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="q1" source="q-fail" target="q-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="q1" source="q-file" target="q-db"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
