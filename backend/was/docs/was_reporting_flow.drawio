<mxfile host="app.diagrams.net" modified="2026-09-25T12:00:00.000Z" agent="Codex" version="24.7.17" compressed="false">
  <diagram id="menu" name="1 Menu Overview">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root>
      <mxCell id="m0"/><mxCell id="m1" parent="m0"/>
      <mxCell id="mt" value="WAS Operator Menu Flow" style="text;html=1;align=center;fontSize=28;fontStyle=1;" vertex="1" parent="m1"><mxGeometry x="400" y="25" width="600" height="45" as="geometry"/></mxCell>
      <mxCell id="ms" value="Operator runs make menu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="m1"><mxGeometry x="550" y="110" width="300" height="60" as="geometry"/></mxCell>
      <mxCell id="mc" value="Docker starts was-menu&#xa;Banner and main menu are displayed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="m1"><mxGeometry x="525" y="220" width="350" height="75" as="geometry"/></mxCell>
      <mxCell id="mm" value="WAS Reporting Operations&#xa;0 Quit&#xa;1 Report generation&#xa;2 Report tracker&#xa;3 Stakeholder management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;fontSize=15;" vertex="1" parent="m1"><mxGeometry x="525" y="345" width="350" height="145" as="geometry"/></mxCell>
      <mxCell id="mr" value="1 Report Generation&#xa;See page 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="m1"><mxGeometry x="80" y="610" width="330" height="100" as="geometry"/></mxCell>
      <mxCell id="mk" value="2 Report Tracker&#xa;See page 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="m1"><mxGeometry x="535" y="610" width="330" height="100" as="geometry"/></mxCell>
      <mxCell id="mh" value="3 Stakeholder Management&#xa;See page 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="m1"><mxGeometry x="990" y="610" width="330" height="100" as="geometry"/></mxCell>
      <mxCell id="mn" value="Navigation is option 0 at the top. In submenus, 0 or b returns to the main menu. Entering b during supported long-running operations requests cancellation at a safe checkpoint." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="m1"><mxGeometry x="350" y="775" width="700" height="80" as="geometry"/></mxCell>
      <mxCell id="me1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="m1" source="ms" target="mc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="me2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="m1" source="mc" target="mm"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="me3" value="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="m1" source="mm" target="mr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="me4" value="2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="m1" source="mm" target="mk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="me5" value="3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="m1" source="mm" target="mh"><mxGeometry relative="1" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="reports" name="2 Report Generation">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root>
      <mxCell id="r0"/><mxCell id="r1" parent="r0"/>
      <mxCell id="rt" value="Report Generation" style="text;html=1;align=center;fontSize=28;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="500" y="20" width="600" height="45" as="geometry"/></mxCell>
      <mxCell id="rm" value="0 Back to main menu&#xa;1 Run the complete recent scan batch&#xa;2 Process eligible automated tracker reports&#xa;3 Process an eligible manual tracker report&#xa;4 Generate an on-demand report to S3 (optional email)&#xa;5 Generate a standalone report for a Qualys tag NOT in the stakeholder database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="385" y="85" width="830" height="185" as="geometry"/></mxCell>
      <mxCell id="ra" value="1 Complete recent scan batch&#xa;&#xa;Runs inside the single menu container. Choose analyst override or customer delivery, refresh, generate, archive, deliver, and summarize. Customer delivery requires explicit confirmation. Use host make recent-scan-batch for separate parallel worker containers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="r1"><mxGeometry x="45" y="330" width="470" height="185" as="geometry"/></mxCell>
      <mxCell id="rb" value="2 Eligible automated tracker reports&#xa;&#xa;Processes all eligible automated rows, not one tag. Existing claims, sent state, holds, and latest-row eligibility prevent duplicate work." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="r1"><mxGeometry x="565" y="330" width="470" height="185" as="geometry"/></mxCell>
      <mxCell id="rc" value="3 One eligible manual tracker report&#xa;&#xa;Enter a stakeholder tag and process one eligible manual row. The report run remains linked to its tracker row and prior run history is preserved." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="r1"><mxGeometry x="1085" y="330" width="470" height="185" as="geometry"/></mxCell>
      <mxCell id="rd" value="4 On-demand report&#xa;&#xa;Generate a new report, archive to S3, and optionally email an email-enabled analyst address. An existing tracker row may be linked. Scan tracker rows are not changed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="r1"><mxGeometry x="190" y="590" width="520" height="185" as="geometry"/></mxCell>
      <mxCell id="re" value="5 Standalone Qualys-tag report&#xa;&#xa;For a tag not enrolled in was_stakeholders. The target is stored separately and never enters stakeholder data, the report tracker, or automatic batches. Archive to S3 and optionally deliver to permitted analysts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="r1"><mxGeometry x="890" y="590" width="520" height="185" as="geometry"/></mxCell>
      <mxCell id="rf" value="Durable evidence includes report-run and email status, S3 URI, SES message ID, failure stage, attempts, and private logs. Held or uncertain deliveries require reconciliation before an ordinary retry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="350" y="850" width="900" height="85" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="tracker" name="3 Report Tracker">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root>
      <mxCell id="t0"/><mxCell id="t1" parent="t0"/>
      <mxCell id="tt" value="Report Tracker" style="text;html=1;align=center;fontSize=28;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="500" y="20" width="600" height="45" as="geometry"/></mxCell>
      <mxCell id="tm" value="0 Back to main menu&#xa;1 View tracker table&#xa;2 View one tracker row&#xa;3 View persisted report errors&#xa;4 Record a manual report sent date&#xa;5 Export tracker CSV&#xa;6 Import tracker rows from XLSX&#xa;7 View all tracker entries for a customer tag&#xa;8 Correct a tracker row&#xa;9 Refresh the report tracker from API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="480" y="85" width="640" height="260" as="geometry"/></mxCell>
      <mxCell id="tr" value="Read and diagnose&#xa;&#xa;1 Filtered tracker table&#xa;2 One tracker row&#xa;3 Persisted report errors&#xa;7 One customer, optionally including child tags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="t1"><mxGeometry x="45" y="420" width="350" height="190" as="geometry"/></mxCell>
      <mxCell id="ti" value="Exchange data&#xa;&#xa;5 Export CSV using a supported destination&#xa;6 Import XLSX. Matching schedule/date rows are overwritten, workbook duplicates are ignored, and imported history cannot trigger reports." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="t1"><mxGeometry x="425" y="420" width="350" height="190" as="geometry"/></mxCell>
      <mxCell id="tc" value="Controlled corrections&#xa;&#xa;4 Record a manual sent date&#xa;8 Correct a tracker row after showing current values and requiring confirmation&#xa;&#xa;Changes are validated and auditable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="t1"><mxGeometry x="805" y="420" width="350" height="190" as="geometry"/></mxCell>
      <mxCell id="tf" value="9 Refresh from API&#xa;&#xa;Retrieve Qualys schedules and parent MULTI/SINGLE scans, consolidate SLICE status, match stakeholders, and upsert schedule execution rows. This replaces the retired Qualys Operations menu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="t1"><mxGeometry x="1185" y="420" width="350" height="190" as="geometry"/></mxCell>
      <mxCell id="tn" value="Tracker refresh and report generation are separate phases. Viewing, exporting, and diagnostics do not generate reports or send customer email." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="t1"><mxGeometry x="350" y="720" width="900" height="85" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="stakeholders" name="4 Stakeholder Management">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0"><root>
      <mxCell id="s0"/><mxCell id="s1" parent="s0"/>
      <mxCell id="st" value="Stakeholder Management" style="text;html=1;align=center;fontSize=28;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="450" y="20" width="700" height="45" as="geometry"/></mxCell>
      <mxCell id="sm" value="0 Back to main menu&#xa;1 View a stakeholder row&#xa;2 Update a stakeholder row&#xa;3 Update a stakeholder's point of contact information&#xa;4 Add new stakeholder by CLI&#xa;5 Import new stakeholders from CSV&#xa;6 Export stakeholders to CSV&#xa;7 Retrieve a stakeholder report password&#xa;8 Rotate a stakeholder report password&#xa;9 Manually enter stakeholder report password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="440" y="90" width="720" height="260" as="geometry"/></mxCell>
      <mxCell id="sr" value="View and maintain&#xa;&#xa;1 View current row&#xa;2 Update validated editable fields&#xa;3 Update POC names and email addresses&#xa;&#xa;Tag-first workflows verify that the stakeholder exists before requesting other input." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="s1"><mxGeometry x="80" y="430" width="430" height="210" as="geometry"/></mxCell>
      <mxCell id="se" value="Create and exchange&#xa;&#xa;4 Add one stakeholder using enum choices and validated dates&#xa;5 Import new tags without overwriting existing stakeholders&#xa;6 Export CSV using a supported destination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="s1"><mxGeometry x="585" y="430" width="430" height="210" as="geometry"/></mxCell>
      <mxCell id="sp" value="Passwords&#xa;&#xa;7 Retrieve after confirmation&#xa;8 Rotate to a generated password&#xa;9 Enter a customer-provided password&#xa;&#xa;Passwords are not logged. Allowed punctuation and intentional whitespace are preserved." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="s1"><mxGeometry x="1090" y="430" width="430" height="210" as="geometry"/></mxCell>
      <mxCell id="sv" value="CLI and database validation enforce required fields, tag and email formatting, accepted dates, and supported enum choices. INTERNATIONAL is used for international stakeholders." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="350" y="740" width="900" height="85" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="batch" name="5 Batch and Diagnostics">
    <mxGraphModel dx="1700" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0"><root>
      <mxCell id="b0"/><mxCell id="b1" parent="b0"/>
      <mxCell id="bt" value="Batch Coordination, Delivery, and Troubleshooting" style="text;html=1;align=center;fontSize=28;fontStyle=1;" vertex="1" parent="b1"><mxGeometry x="400" y="20" width="900" height="45" as="geometry"/></mxCell>
      <mxCell id="bs" value="Production recent-scan batch or isolated capacity test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="b1"><mxGeometry x="55" y="130" width="300" height="95" as="geometry"/></mxCell>
      <mxCell id="bc" value="Coordinator&#xa;Assign batch UUID&#xa;Run preflight and tracker phase&#xa;Partition eligible work&#xa;Aggregate outcomes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="b1"><mxGeometry x="435" y="110" width="330" height="135" as="geometry"/></mxCell>
      <mxCell id="bw" value="Separate Docker worker containers&#xa;Each worker claims report runs and performs Qualys retrieval, PDF generation and encryption, and S3 archival for its partition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="b1"><mxGeometry x="850" y="110" width="380" height="135" as="geometry"/></mxCell>
      <mxCell id="bd" value="Shared delivery and summaries&#xa;Record SES acceptance once&#xa;Tracker-phase summary&#xa;Final performance summary after completion&#xa;Open manuals grouped by assignee" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="b1"><mxGeometry x="1320" y="110" width="330" height="135" as="geometry"/></mxCell>
      <mxCell id="bb" value="PostgreSQL coordination&#xa;Transactional claims, report history, attempts, held and uncertain delivery state, replay batches, and metrics support idempotency and recovery" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="b1"><mxGeometry x="560" y="340" width="580" height="145" as="geometry"/></mxCell>
      <mxCell id="bl" value="Batch-specific private logs&#xa;local-output/logs/batches/&amp;lt;batch-id&amp;gt;/&#xa;&#xa;Plain text and structured JSONL for coordinator, tracker, workers, delivery, and summaries. Context includes batch, role, worker, phase, tag, tracker ID, report-run ID, and event." style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="b1"><mxGeometry x="190" y="585" width="560" height="205" as="geometry"/></mxCell>
      <mxCell id="bm" value="Read-only Make diagnostics&#xa;&#xa;make logs-latest&#xa;make logs-summary LOG_BATCH_ID=&amp;quot;&amp;lt;uuid&amp;gt;&amp;quot;&#xa;make logs-errors LOG_BATCH_ID=&amp;quot;&amp;lt;uuid&amp;gt;&amp;quot;&#xa;make logs-tag LOG_BATCH_ID=&amp;quot;&amp;lt;uuid&amp;gt;&amp;quot; LOG_TAG=&amp;quot;&amp;lt;tag&amp;gt;&amp;quot;&#xa;Optional: LOG_LIMIT=&amp;lt;count&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="b1"><mxGeometry x="950" y="585" width="560" height="205" as="geometry"/></mxCell>
      <mxCell id="bn" value="Diagnostics read local structured logs only. They do not call Qualys, update the database or tracker, generate reports, delete files, or send email. Older batches may have only standalone plain-text logs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="b1"><mxGeometry x="400" y="890" width="900" height="90" as="geometry"/></mxCell>
      <mxCell id="be1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="b1" source="bs" target="bc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="be2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="b1" source="bc" target="bw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="be3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="b1" source="bw" target="bd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="be4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="b1" source="bc" target="bb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="be5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="b1" source="bw" target="bb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="be6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="b1" source="bc" target="bl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="be7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="b1" source="bl" target="bm"><mxGeometry relative="1" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
</mxfile>
