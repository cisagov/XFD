# Base image for Python environment
FROM python:3.12-slim-trixie

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    unzip \
    netcat-traditional \
    build-essential \
    --no-install-recommends && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Python dependencies from worker and application
RUN pip install --upgrade pip setuptools wheel
COPY worker/requirements.txt /app/worker/requirements.txt
COPY requirements.txt /app/requirements.txt
COPY external/pshtt external/pshtt

RUN pip install --no-cache-dir -r /app/requirements.txt
RUN pip install --no-cache-dir -r /app/worker/requirements.txt
# mitmproxy 12 requires cryptography<44.1; the main backend requirements may install newer.
# Re-pin after the full tree resolves so the runtime matches mitmproxy and worker/requirements.txt.
RUN pip install --no-cache-dir "cryptography==44.0.1"

# Copy worker scripts and Django project
COPY worker worker
COPY src/xfd_django .

# Set environment variables
ENV DJANGO_SETTINGS_MODULE=xfd_django.settings
ENV PYTHONPATH="/app:$PYTHONPATH"
ENV PYTHONUNBUFFERED=1

# Make the entry script executable
RUN chmod +x worker/worker-entry.sh

# Default entrypoint
CMD ["worker/worker-entry.sh"]
