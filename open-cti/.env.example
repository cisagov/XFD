# Template for open-cti/.env -- every variable docker-compose.yml actually reads.
# Copy to `.env` and fill in real values. Never commit the real `.env` (already gitignored
# repo-wide). This file only ever holds placeholders/non-sensitive defaults.
#
# Lines marked "SSM:" are secrets managed as SecureString placeholders in
# infrastructure/open_cti.tf (see var.open_cti_secret_keys) -- pull the real value with:
#   aws ssm get-parameter --name "<path>" --with-decryption --query Parameter.Value --output text
# Lines without an SSM pointer are non-secret config -- safe to hardcode directly.

# --- Compose / general -------------------------------------------------------
COMPOSE_PROJECT_NAME=open-cti

# --- Elasticsearch ------------------------------------------------------------
ELASTIC_MEMORY_SIZE=4g

# --- XTM One Postgres (pgvector) -----------------------------------------------
XTM_ONE_POSTGRES_USER=xtm_one
XTM_ONE_POSTGRES_PASSWORD=  # SSM: /crossfeed/staging/opencti/XTM_ONE_POSTGRES_PASSWORD

# --- MinIO ----------------------------------------------------------------------
MINIO_ROOT_USER=openctiminio
MINIO_ROOT_PASSWORD=  # SSM: /crossfeed/staging/opencti/MINIO_ROOT_PASSWORD

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_DEFAULT_USER=openctirabbitmq
RABBITMQ_DEFAULT_PASS=  # SSM: /crossfeed/staging/opencti/RABBITMQ_DEFAULT_PASS

# --- xtm-composer (manages connector containers via the Docker socket) --------
XTM_COMPOSER_ID=  # a valid UUIDv4, stable identity for this composer instance

# --- OpenCTI platform -----------------------------------------------------------
OPENCTI_EXTERNAL_SCHEME=https
OPENCTI_HOST=
OPENCTI_PORT=8080
OPENCTI_ADMIN_EMAIL=
OPENCTI_ADMIN_PASSWORD=  # SSM: /crossfeed/staging/opencti/OPENCTI_ADMIN_PASSWORD
OPENCTI_ADMIN_TOKEN=  # SSM: /crossfeed/staging/opencti/OPENCTI_ADMIN_TOKEN (a valid UUIDv4)
OPENCTI_ENCRYPTION_KEY=  # SSM: /crossfeed/staging/opencti/OPENCTI_ENCRYPTION_KEY -- NEVER rotate; breaks decryption of existing data
OPENCTI_HEALTHCHECK_ACCESS_KEY=  # SSM: /crossfeed/staging/opencti/OPENCTI_HEALTHCHECK_ACCESS_KEY
SMTP_HOSTNAME=

# --- XTM One integration (registration token shared between opencti + xtm-one) --
PLATFORM_REGISTRATION_TOKEN=  # SSM: /crossfeed/staging/opencti/PLATFORM_REGISTRATION_TOKEN

# --- Connectors: file export/import (stable UUIDv4 identities, not secret, but must
#     stay consistent across rebuilds or OpenCTI will register them as new connectors) --
CONNECTOR_EXPORT_FILE_STIX_ID=
CONNECTOR_EXPORT_FILE_CSV_ID=
CONNECTOR_EXPORT_FILE_TXT_ID=
CONNECTOR_IMPORT_FILE_STIX_ID=
CONNECTOR_IMPORT_DOCUMENT_ID=
CONNECTOR_IMPORT_FILE_YARA_ID=
CONNECTOR_ANALYSIS_ID=
CONNECTOR_IMPORT_EXTERNAL_REFERENCE_ID=
CONNECTOR_OPENCTI_ID=
CONNECTOR_MITRE_ID=

# --- Connectors: external enrichment/import services (API keys are secrets) -----
SHODAN_API_KEY=  # SSM: /crossfeed/staging/opencti/SHODAN_API_KEY
CONNECTOR_SHODAN_API_KEY=  # SSM: /crossfeed/staging/opencti/CONNECTOR_SHODAN_API_KEY

NVD_API_KEY=  # SSM: /crossfeed/staging/opencti/NVD_API_KEY
CONNECTOR_CVE_API_KEY=  # SSM: /crossfeed/staging/opencti/CONNECTOR_CVE_API_KEY

CENSYS_ORG_ID=
CENSYS_API_KEY=  # SSM: /crossfeed/staging/opencti/CENSYS_API_KEY
CONNECTOR_CENSYS_API_KEY=  # SSM: /crossfeed/staging/opencti/CONNECTOR_CENSYS_API_KEY

VULNCHECK_API_KEY=  # SSM: /crossfeed/staging/opencti/VULNCHECK_API_KEY
CONNECTOR_VULNCHECK_API_KEY=  # SSM: /crossfeed/staging/opencti/CONNECTOR_VULNCHECK_API_KEY

CONNECTOR_CISA_KEV_API_KEY=  # SSM: /crossfeed/staging/opencti/CONNECTOR_CISA_KEV_API_KEY

QUALYS_API_USERNAME=
QUALYS_API_PASSWORD=  # SSM: /crossfeed/staging/opencti/QUALYS_API_PASSWORD
CONNECTOR_QUALYS_CVE_ENRICHMENT_API_KEY=  # SSM: /crossfeed/staging/opencti/CONNECTOR_QUALYS_CVE_ENRICHMENT_API_KEY

# --- XTM One platform -------------------------------------------------------------
XTM_ONE_EXTERNAL_SCHEME=https
XTM_ONE_HOST=
XTM_ONE_PORT=4000
XTM_ONE_ADMIN_EMAIL=
XTM_ONE_ADMIN_PASSWORD=  # SSM: /crossfeed/staging/opencti/XTM_ONE_ADMIN_PASSWORD
XTM_ONE_SECRET_KEY=  # SSM: /crossfeed/staging/opencti/XTM_ONE_SECRET_KEY
XTM_ONE_S3_BUCKET=xtm-one-files
XTM_ONE_LOG_LEVEL=info
XTM_ONE_LOG_FORMAT=json
XTM_ONE_ENTERPRISE_LICENSE=  # SSM: /crossfeed/staging/opencti/XTM_ONE_ENTERPRISE_LICENSE
