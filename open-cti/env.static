# open-cti/env.static -- universal, non-secret config for the open-cti Docker Compose stack.
# Deployed verbatim (via file(), not templatefile()) to /opt/open-cti/env.static at boot, folded
# into /opt/open-cti/.env every boot by bootstrap.sh. Identical across every environment --
# per-environment values belong in infrastructure/vars.tf + *.tfvars instead (open_cti_host and
# friends), not here. Secrets never belong here either -- see var.open_cti_secret_keys.
#
# Comments here are intentionally terse -- this file is embedded whole into EC2 user_data (16KB
# limit). Full rationale/history: open-cti/STATUS.md. Safe to edit and redeploy EXCEPT the 11
# STABLE IDENTIFIERS below -- read that warning before touching any of them.

COMPOSE_PROJECT_NAME="xtm" # confirmed vs. stage-cd's real .env -- NOT .env.example's default; renames the Compose project (orphans existing volumes) if changed
ELASTIC_MEMORY_SIZE="4G"
XTM_ONE_POSTGRES_USER="postgres_user_1" # confirmed vs. stage-cd's real .env
# MINIO_ROOT_USER deliberately not here -- on stage-cd it's a UUID (credential-grade, not a plain
# username), moved into var.open_cti_secret_keys/SSM instead.
RABBITMQ_DEFAULT_USER="opencti" # confirmed vs. stage-cd's real .env
OPENCTI_EXTERNAL_SCHEME="http" # confirmed vs. stage-cd's real .env -- NOT .env.example's https
OPENCTI_PORT="8080"

# XTM One platform -- UNCONFIRMED against a live box (stage-cd's real .env has none of these keys;
# XTM One isn't actually active there). Left as .env.example's generic defaults.
XTM_ONE_EXTERNAL_SCHEME="https"
XTM_ONE_PORT="4000"
XTM_ONE_S3_BUCKET="xtm-one-files"
XTM_ONE_LOG_LEVEL="info"
XTM_ONE_LOG_FORMAT="json"

# STABLE IDENTIFIERS -- not secrets, but each MUST stay constant across reboots/rebuilds.
# OpenCTI/xtm-composer use them to recognize "the same connector/composer as before"; changing one
# registers a duplicate instead of resuming the existing one. Pulled from stage-cd's real, running
# .env -- never regenerate these for stage-cd. A genuinely new environment with nothing registered
# yet is the only case fresh uuidgen values would apply.
XTM_COMPOSER_ID="8215614c-7139-422e-b825-b20fd2a13a23"
CONNECTOR_EXPORT_FILE_STIX_ID="dd817c8b-abae-460a-9ebc-97b1551e70e6"
CONNECTOR_EXPORT_FILE_CSV_ID="7ba187fb-fde8-4063-92b5-c3da34060dd7"
CONNECTOR_EXPORT_FILE_TXT_ID="ca715d9c-bd64-4351-91db-33a8d728a58b"
CONNECTOR_IMPORT_FILE_STIX_ID="72327164-0b35-482b-b5d6-a5a3f76b845f"
CONNECTOR_IMPORT_DOCUMENT_ID="c3970f8a-ce4b-4497-a381-20b7256f56f0"
CONNECTOR_IMPORT_FILE_YARA_ID="7eb45b60-069b-4f7f-83a2-df4d6891d5ec"
CONNECTOR_ANALYSIS_ID="4dffd77c-ec11-4abe-bca7-fd997f79fa36"
CONNECTOR_IMPORT_EXTERNAL_REFERENCE_ID="d52dcbc8-fa06-42c7-bbc2-044948c87024"
CONNECTOR_OPENCTI_ID="dd010812-9027-4726-bf7b-4936979955ae"
CONNECTOR_MITRE_ID="8307ea1e-9356-408c-a510-2d7f8b28a0e2"
